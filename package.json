{
  "name": "dads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b tsconfig.worker.json tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "migrate:local": "wrangler d1 migrations apply dads --local",
    "migrate:remote": "wrangler d1 migrations apply dads --remote",
    "types": "wrangler types --strict-vars=false",
    "group:create": "tsx scripts/create-group.ts",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "icons": "node scripts/icons.mjs",
    "vapid": "node scripts/vapid.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.130.0"
  }
}
