{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo"
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "vite.config.ts", "e2e/**/*.ts"]
}
