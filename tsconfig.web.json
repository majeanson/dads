{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo"
  },
  "include": [
    "src/shared/**/*.ts",
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "vite.config.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "src/worker/crypto.ts"
  ]
}
